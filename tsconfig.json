{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@business-os/shared/*": ["packages/shared/src/*"],
      "@business-os/database/*": ["packages/database/src/*"],
      "@business-os/config/*": ["packages/config/src/*"]
    }
  },
  "exclude": ["node_modules", "archives"]
}
